+import Parser from 'web-tree-sitter'
+import { createRequire } from 'node:module'
+import { extname } from 'node:path'
+import type { CodePosition, CodeRange, CodeQueryId } from './code-intelligence-contracts.js'
+const require = createRequire(import.meta.url)
+let initialized: Promise<void> | undefined
+const languages = new Map<string, Promise<Parser.Language>>()
+export const DECLARATIONS = ['function_declaration','class_declaration','lexical_declaration','variable_declaration','method_definition','interface_declaration','type_alias_declaration','enum_declaration']
+export const QUERIES = { declarations: DECLARATIONS, calls: ['call_expression','new_expression'], imports: ['import_statement','export_statement'] } as const
+export function languageFor(path: string): string | undefined {
+  const ext = extname(path).toLowerCase()
+  return ['.ts','.mts','.cts'].includes(ext) ? 'typescript' : ext === '.tsx' ? 'tsx' : ['.js','.jsx','.mjs','.cjs'].includes(ext) ? 'javascript' : undefined
+}
+export async function parseCode(text: string, language: string, signal: AbortSignal): Promise<Parser.Tree> {
+  initialized ??= Parser.init({ locateFile: () => require.resolve('web-tree-sitter/tree-sitter.wasm') })
+  await initialized; signal.throwIfAborted()
+  let grammar = languages.get(language)
+  if (!grammar) { grammar = Parser.Language.load(require.resolve(`tree-sitter-wasms/out/tree-sitter-${language}.wasm`)); languages.set(language, grammar) }
+  const parser = new Parser()
+  try {
+    parser.setLanguage(await grammar); signal.throwIfAborted(); parser.setTimeoutMicros(1500000)
+    const tree = parser.parse(text)
+    if (!tree) throw new Error('parser_deadline')
+    if (signal.aborted) { tree.delete(); signal.throwIfAborted() }
+    return tree
+  } finally { parser.delete() }
+}
+/** The web binding indexes JavaScript UTF-16 units. Derive line offsets from pinned text. */
+export function positionAt(text: string, offset: number): CodePosition {
+  let line = 0, start = 0
+  for (let i = 0; i < offset; i++) if (text[i] === '\n') { line++; start = i + 1 }
+  return { line, character: offset - start - (text[offset - 1] === '\r' && text[offset] === '\n' ? 1 : 0) }
+}
+export function offsetAt(text: string, position: CodePosition): number {
+  if (!Number.isSafeInteger(position.line) || !Number.isSafeInteger(position.character) || position.line < 0 || position.character < 0) throw new Error('invalid_position')
+  let start = 0
+  for (let line = 0; line < position.line; line++) { const next = text.indexOf('\n', start); if (next < 0) throw new Error('invalid_position'); start = next + 1 }
+  const newline = text.indexOf('\n', start), end = newline < 0 ? text.length : newline
+  const length = end - start - (newline >= 0 && text[end - 1] === '\r' ? 1 : 0)
+  if (position.character > length) throw new Error('invalid_position')
+  const offset = start + position.character
+  // Reject a UTF-16 position inside a surrogate pair.
+  if (offset > 0 && /[\uD800-\uDBFF]/.test(text[offset - 1]!) && /[\uDC00-\uDFFF]/.test(text[offset] ?? '')) throw new Error('invalid_position')
+  return offset
+}
+export function rangeOf(text: string, node: Parser.SyntaxNode): CodeRange { return { start: positionAt(text,node.startIndex), end: positionAt(text,node.endIndex) } }
+/** Distributed capture predicates, applied to parser nodes with a bounded cursor. */
+export function captures(tree: Parser.Tree, query: CodeQueryId, text: string, range: CodeRange | undefined, limit: number, signal: AbortSignal): { nodes: Parser.SyntaxNode[]; omitted: number } {
+  const start = range ? offsetAt(text,range.start) : 0, end = range ? offsetAt(text,range.end) : text.length
+  if (end < start) throw new Error('invalid_range')
+  const cursor = tree.walk(), nodes: Parser.SyntaxNode[] = []; let total = 0
+  const deadline = performance.now() + 1900
+  try {
+    while (true) {
+      signal.throwIfAborted(); if (performance.now() > deadline) throw new Error('parser_deadline')
+      const node = cursor.currentNode
+      if ((QUERIES[query] as readonly string[]).includes(node.type) && node.startIndex >= start && node.endIndex <= end) {
+        total++; if (nodes.length < limit) nodes.push(node)
+      }
+      if (cursor.gotoFirstChild()) continue
+      while (!cursor.gotoNextSibling()) if (!cursor.gotoParent()) return { nodes, omitted: Math.max(0,total-limit) }
+    }
+  } finally { cursor.delete() }
+}
