--- /dev/null
+++ b/src/code-intelligence.ts
@@ -0,0 +1,200 @@
+import { symbols } from '@deepseek-ai/cordis'
+import { validCodeRequest } from './code-request.js'
+import { fileURLToPath } from 'node:url'
+import { createHash, randomUUID } from 'node:crypto'
+import type Parser from 'web-tree-sitter'
+import type { FileSystem, FsTarget } from '@deepseek-ai/dsh-fs'
+import type { CodeIntelligenceServiceV1, CodeHostBindingV1, CodeLeaseV1, CodeRequestV1, CodeResponseV1, CodeCapabilitiesV1 } from './code-intelligence-contracts.js'
+import type { HostSource } from './host/dsh.js'
+import { captures, languageFor, offsetAt, parseCode, rangeOf } from './code-structure.js'
+import { WebstackLspRuntime, type HostSubprocess } from './runtime/webstack-runtime.js'
+import type { ResolvedConfig } from './config.js'
+interface Snapshot { handle: string; path: string; target: FsTarget; version: string; source: HostSource; tree: Parser.Tree; language: string; inputBytes: number; nodes: Map<string,Parser.SyntaxNode> }
+function identity(value:unknown):unknown { return value && typeof value === 'object' ? (value as Record<symbol,unknown>)[symbols.original] ?? value : value }
+function outcome(status: CodeResponseV1['status'], reason: string): CodeResponseV1 { return { protocol:'code-intelligence/v1', status, reason, sourceKind:'disk', freshness:status === 'stale' ? 'stale':'unknown', truncated:false, omitted:0 } }
+export function createCodeIntelligenceService(config: ResolvedConfig): CodeIntelligenceServiceV1 & {dispose():Promise<void>} {
+  const leases = new Set<CodeLeaseV1>(); let closed = false
+  return { version:1, capabilities:['snapshots','structure','semantic'],
+    async bind(binding, signal) {
+      if (closed || !binding || typeof binding.assertCurrent !== 'function' || !binding.scope || !binding.owner?.agentId || !binding.owner?.sessionId || !binding.workspaceRoot) throw new Error('invalid_host_binding')
+      await binding.assertCurrent()
+      const fs = binding.context.get('fs',false) as FileSystem | undefined
+      const subprocess = binding.context.get('subprocess',false) as HostSubprocess | undefined
+      if (!fs || !subprocess) throw new Error('scoped_host_services_missing')
+      const lease = await CodeLease.create(binding,fs,new WebstackLspRuntime(config,fs,subprocess),() => leases.delete(lease),signal)
+      if (closed) { await lease.dispose(); throw new Error('provider_disposed') }
+      leases.add(lease); return lease
+    },
+    async dispose() { closed = true; await Promise.all([...leases].map(lease => lease.dispose())) }
+  }
+}
+class CodeLease implements CodeLeaseV1 {
+  #snapshots = new Map<string,Snapshot>(); #nodes = new Map<string,Snapshot>(); #closed = false
+  #lifetime = new AbortController(); #checkout = ''; #files=0; #bytes=0; #outputs=0; #calls=0; #start=performance.now(); #semanticReady=false
+  private constructor(readonly binding: CodeHostBindingV1, readonly fs: FileSystem, readonly root: FsTarget, readonly runtime: WebstackLspRuntime, readonly removed:()=>void, readonly subprocess:HostSubprocess) {}
+  static async create(binding: CodeHostBindingV1, fs: FileSystem, runtime: WebstackLspRuntime, removed:()=>void, signal:AbortSignal): Promise<CodeLease> {
+    signal.throwIfAborted()
+    const root = await fs.resolve(binding.workspaceRoot,{signal})
+    if ((await fs.stat(root,signal))?.type !== 'directory') { await runtime.dispose(); throw new Error('workspace_missing') }
+    const lease = new CodeLease(binding,fs,root,runtime,removed,binding.context.get('subprocess',false) as HostSubprocess)
+    try { lease.#checkout = await lease.checkout(signal); await binding.assertCurrent(); return lease } catch(error) { await lease.dispose(); throw error }
+  }
+  private async checkout(signal:AbortSignal=this.#lifetime.signal): Promise<string> {
+    // Read metadata through the caller's host filesystem; never bypass that world with Node fs.
+    const git = await this.fs.resolve('.git',{cwd:this.fs.processPath(this.root),signal})
+    if (!this.fs.contains(this.root,git)) throw new Error('checkout_outside_scope')
+    const stat = await this.fs.stat(git,signal)
+    if (!stat) return `directory:${this.root.targetKey}`
+    if (stat.type !== 'directory') throw new Error('worktree_metadata_unavailable')
+    const read = async(path:string,limit=4096) => {
+      const target = await this.fs.resolve(path,{cwd:this.fs.processPath(this.root),signal})
+      if (!this.fs.contains(git,target)) throw new Error('checkout_outside_scope')
+      let text=''; for await(const chunk of await this.fs.streamText(target,signal)) { text+=chunk; if(text.length>limit)throw new Error('checkout_metadata_limit') }
+      return text
+    }
+    const head=await read('.git/HEAD'); const ref=head.match(/^ref: (refs\/[\w./-]+)\s*$/)?.[1]
+    let resolved=head
+    if(ref) {
+      const target=await this.fs.resolve(`.git/${ref}`,{cwd:this.fs.processPath(this.root),signal})
+      if(!this.fs.contains(git,target))throw new Error('checkout_outside_scope')
+      if(await this.fs.stat(target,signal))resolved+=await read(`.git/${ref}`)
+      else {
+        const packed=await read('.git/packed-refs',1048576)
+        const revision=packed.split(/\r?\n/).find(line=>line.split(' ')[1]===ref)?.split(' ')[0]
+        if(!revision||!/^[a-f0-9]{40,64}$/.test(revision))throw new Error('checkout_ref_unavailable')
+        resolved+=revision
+      }
+    }
+    return createHash('sha256').update(this.root.targetKey+'\0'+resolved).digest('hex')
+  }
+  private async current(signal:AbortSignal):Promise<void> {
+    signal.throwIfAborted(); if(this.#closed)throw new Error('evaluation_closed')
+    await this.binding.assertCurrent()
+    if(identity(this.binding.context.get('fs',false))!==identity(this.fs)||identity(this.binding.context.get('subprocess',false))!==identity(this.subprocess))throw new Error('scope_changed')
+    const root=await this.fs.resolve(this.binding.workspaceRoot,{signal})
+    if(root.targetKey!==this.root.targetKey || await this.checkout(signal)!==this.#checkout)throw new Error('checkout_changed')
+  }
+  private async fresh(snapshot:Snapshot,signal:AbortSignal):Promise<void> {
+    const target=await this.fs.resolve(snapshot.path,{cwd:this.fs.processPath(this.root),signal})
+    if(!this.fs.contains(this.root,target)||target.targetKey!==snapshot.target.targetKey||JSON.stringify((await this.fs.stat(target,signal))?.version)!==snapshot.version)throw new Error('source_changed')
+  }
+  async request(input:CodeRequestV1,caller:AbortSignal):Promise<CodeResponseV1> {
+    if(!validCodeRequest(input)){this.#calls++;return this.#calls>100?outcome('limit_exceeded','evaluation_budget'):outcome('unsupported','invalid_request')}
+    const signal=AbortSignal.any([caller,this.#lifetime.signal,AbortSignal.timeout(input.method==='semantic.query'?10000:2000)])
+    try {
+      if(input.method==='snapshot.release') { this.release(input.handle); return {...outcome('ok','released'),data:{released:true}} }
+      await this.current(signal)
+      if(++this.#calls>100 || performance.now()-this.#start>30000 || this.#outputs>=65536) return outcome('limit_exceeded','evaluation_budget')
+      let response:CodeResponseV1
+      if(input.method==='capabilities') response={...outcome('ok','capabilities'),data:this.capabilities()}
+      else if(input.method==='snapshot.open') response=await this.open(input.path,signal)
+      else {
+        const snapshot='handle' in input?this.#snapshots.get(input.handle):'nodeHandle' in input?this.#nodes.get(input.nodeHandle):undefined
+        if(!snapshot)return outcome('stale','unknown_handle')
+        await this.fresh(snapshot,signal)
+        response=await this.query(snapshot,input,signal)
+        await this.fresh(snapshot,signal)
+      }
+      await this.current(signal)
+      response=this.bound(response)
+      this.#outputs+=Buffer.byteLength(JSON.stringify(response))
+      return this.#outputs>65536?outcome('limit_exceeded','response_budget'):response
+    }catch(error) {
+      if(signal.aborted)return outcome(this.#lifetime.signal.aborted||caller.aborted&&caller.reason?.name!=='TimeoutError'?'cancelled':'timeout','operation_deadline')
+      const message=error instanceof Error?error.message:''
+      if(['source_changed','checkout_changed','evaluation_closed','scope_changed'].includes(message))return outcome('stale',message)
+      if(message==='invalid_position'||message==='invalid_range')return outcome('unsupported',message)
+      if(message==='parser_deadline')return outcome('timeout',message)
+      if(message.includes('limit'))return outcome('limit_exceeded','provider_limit')
+      if((error as {code?:string})?.code==='LSP_UNSUPPORTED_OPERATION')return outcome('unsupported','semantic_unsupported')
+      return outcome('unavailable',input.method==='semantic.query'?'semantic_unready':'scope_unavailable')
+    }
+  }
+  private capabilities():CodeCapabilitiesV1 {
+    const languageCapabilities=this.runtime.snapshotSupport()
+    return {version:1,capabilities:['snapshots','structure','semantic'],languages:languageCapabilities.map(item=>item.language),queryIds:['declarations','calls','imports'],sourceKinds:['disk'],semanticReady:this.#semanticReady,
+      languageCapabilities,limits:{documentBytes:2097152,captureItems:200,outlineItems:100,spanChars:8000,responseBytes:32768,files:100,inputBytes:16777216,outputBytes:65536,calls:100,batchMs:30000,structureMs:2000,semanticMs:10000}}
+  }
+  private async open(path:string,signal:AbortSignal):Promise<CodeResponseV1> {
+    const language=languageFor(path);if(!language)return outcome('unsupported','grammar_missing')
+    if(++this.#files>100)return outcome('limit_exceeded','file_budget')
+    const target=await this.fs.resolve(path,{cwd:this.fs.processPath(this.root),signal})
+    if(!this.fs.contains(this.root,target))return outcome('unavailable','outside_workspace')
+    const before=await this.fs.stat(target,signal);if(before?.type!=='file')return outcome('unavailable','not_regular_file')
+    const version=JSON.stringify(before.version)
+    let text='',bytes=0
+    for await(const chunk of await this.fs.streamText(target,signal)) {
+      signal.throwIfAborted();const count=Buffer.byteLength(chunk);bytes+=count;this.#bytes+=count
+      if(bytes>2097152||this.#bytes>16777216)return outcome('limit_exceeded','input_budget')
+      text+=chunk
+    }
+    if(JSON.stringify((await this.fs.stat(target,signal))?.version)!==version)return outcome('stale','source_changed')
+    const tree=await parseCode(text,language,signal)
+    const snapshot:Snapshot={handle:randomUUID(),path,target,version,source:{workspace:this.fs.processPath(this.root),workspaceUri:this.fs.fileUrl(this.root),key:this.root.targetKey,uri:this.fs.fileUrl(target),text},tree,language,inputBytes:bytes,nodes:new Map()}
+    this.#snapshots.set(snapshot.handle,snapshot)
+    try{await this.fresh(snapshot,signal);await this.current(signal)}catch(error){this.release(snapshot.handle);throw error}
+    return {...this.envelope(snapshot),inputBytes:bytes,data:{handle:snapshot.handle,path,language,parseErrors:tree.rootNode.hasError}}
+  }
+  private envelope(snapshot:Snapshot):CodeResponseV1 {
+    return {protocol:'code-intelligence/v1',status:snapshot.tree.rootNode.hasError?'partial':'ok',...(snapshot.tree.rootNode.hasError?{reason:'parse_errors'}:{}),sourceKind:'disk',freshness:'current',snapshotVersion:createHash('sha256').update(this.#checkout+'\0'+snapshot.target.targetKey+'\0'+snapshot.version).digest('hex'),truncated:false,omitted:0}
+  }
+  private node(snapshot:Snapshot,node:Parser.SyntaxNode) {
+    // Reuse handles for the same live node. Snapshot release revokes all of them.
+    let handle=[...snapshot.nodes].find(([,candidate])=>candidate.id===node.id)?.[0]
+    if(!handle) { handle=randomUUID();snapshot.nodes.set(handle,node);this.#nodes.set(handle,snapshot) }
+    const name=node.childForFieldName('name')?.text
+    return {handle,kind:node.type,...(name?{name:name.slice(0,256)}:{}),range:rangeOf(snapshot.source.text,node)}
+  }
+  private async query(snapshot:Snapshot,input:CodeRequestV1,signal:AbortSignal):Promise<CodeResponseV1> {
+    const response=this.envelope(snapshot)
+    if(input.method==='structure.outline'||input.method==='structure.query') {
+      const id=input.method==='structure.query'?input.queryId:'declarations'
+      const {nodes,omitted}=captures(snapshot.tree,id,snapshot.source.text,input.range,input.limit??(input.method==='structure.outline'?100:200),signal)
+      return {...response,...(omitted?{status:'partial' as const,truncated:true,omitted}:{}),data:{items:nodes.map(node=>this.node(snapshot,node)),...(input.method==='structure.query'?{queryId:id}:{})}}
+    }
+    if(input.method==='structure.enclosing') {
+      const offset=offsetAt(snapshot.source.text,input.position),nodes:Parser.SyntaxNode[]=[]
+      let node:Parser.SyntaxNode|null=offset===snapshot.source.text.length?snapshot.tree.rootNode:snapshot.tree.rootNode.namedDescendantForIndex(offset)
+      while(node&&nodes.length<200){if(node.startIndex<=offset&&offset<node.endIndex&&(!input.kinds||input.kinds.includes(node.type)))nodes.push(node);node=node.parent}
+      return {...response,data:{items:nodes.map(node=>this.node(snapshot,node))}}
+    }
+    if(input.method==='structure.span') {
+      const node=snapshot.nodes.get(input.nodeHandle);if(!node)return outcome('stale','unknown_node')
+      const max=input.maxChars??8000,text=snapshot.source.text.slice(node.startIndex,node.endIndex),omitted=Math.max(0,text.length-max)
+      // Avoid cutting a surrogate pair at the display boundary.
+      const end=omitted&&/[\uD800-\uDBFF]/.test(text[max-1]??'')?max-1:max
+      return {...response,...(omitted?{status:'partial' as const,truncated:true,omitted:text.length-end}:{}),data:{text:text.slice(0,end),range:rangeOf(snapshot.source.text,node)}}
+    }
+    if(input.method==='semantic.query') {
+      if(input.position)offsetAt(snapshot.source.text,input.position)
+      const data=await this.runtime.semanticSnapshot(snapshot.source,input.kind,input.position,signal)
+      this.#semanticReady=true
+      // URI validation belongs to the scoped filesystem. Reject all outside locations.
+      if(data && typeof data==='object' && 'items' in data) {
+        const items=(data as {items:Record<string,unknown>[]}).items
+        for(const item of items) if(typeof item.uri==='string') {
+          if(!item.uri.startsWith('file:'))return outcome('unavailable','semantic_uri_outside_workspace')
+          const target=await this.fs.resolve(fileURLToPath(item.uri),{signal})
+          if(!this.fs.contains(this.root,target))return outcome('unavailable','semantic_uri_outside_workspace')
+        }
+        const max=input.limit??200,omitted=Math.max(0,items.length-max)
