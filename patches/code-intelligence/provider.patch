+import type { CodeRequestV1 } from './code-intelligence-contracts.js'
+const keys: Record<string,readonly string[]> = {
+ 'capabilities':['method'],'snapshot.open':['method','path'],'snapshot.release':['method','handle'],
+ 'structure.outline':['method','handle','range','limit'],'structure.enclosing':['method','handle','position','kinds'],
+ 'structure.query':['method','handle','queryId','range','limit'],'structure.span':['method','nodeHandle','maxChars'],
+ 'semantic.query':['method','handle','kind','position','limit']
+}
+function record(value:unknown):value is Record<string,unknown>{return !!value&&typeof value==='object'&&!Array.isArray(value)}
+function position(value:unknown):boolean{return record(value)&&Object.keys(value).length===2&&Number.isSafeInteger(value.line)&&Number.isSafeInteger(value.character)&&Number(value.line)>=0&&Number(value.character)>=0}
+function range(value:unknown):boolean{return record(value)&&Object.keys(value).length===2&&position(value.start)&&position(value.end)}
+export function validCodeRequest(value:unknown):value is CodeRequestV1 {
+ if(!record(value)||typeof value.method!=='string'||!Object.hasOwn(keys,value.method))return false
+ if(Object.keys(value).some(key=>!keys[value.method as string]!.includes(key)))return false
+ for(const field of ['handle','nodeHandle','path']) {
+  if(field in value&&(typeof value[field]!=='string'||!(value[field] as string).length||(value[field] as string).length>(field==='path'?4096:256)))return false
+ }
+ if(value.method==='snapshot.open'&&typeof value.path!=='string'||value.method==='structure.span'&&typeof value.nodeHandle!=='string'||!['capabilities','snapshot.open','structure.span'].includes(value.method)&&typeof value.handle!=='string')return false
+ if('range' in value&&!range(value.range)||'position' in value&&!position(value.position))return false
+ if('limit' in value&&(!Number.isSafeInteger(value.limit)||Number(value.limit)<1||Number(value.limit)>(value.method==='structure.outline'?100:200)))return false
+ if('maxChars' in value&&(!Number.isSafeInteger(value.maxChars)||Number(value.maxChars)<1||Number(value.maxChars)>8000))return false
+ if('kinds' in value&&(!Array.isArray(value.kinds)||value.kinds.length>30||value.kinds.some(kind=>typeof kind!=='string'||kind.length<1||kind.length>100)))return false
+ if(value.method==='structure.enclosing'&&!position(value.position))return false
+ if(value.method==='structure.query'&&!['declarations','calls','imports'].includes(String(value.queryId)))return false
+ if(value.method==='semantic.query'&&(!['definition','references','implementation','hover','diagnostics','completion'].includes(String(value.kind))||value.kind!=='diagnostics'&&!position(value.position)))return false
+ return true
+}
