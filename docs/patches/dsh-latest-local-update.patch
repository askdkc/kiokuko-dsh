+import { expect, it } from 'vitest'
+import { latestRegistryUpdate } from '../src/operations.ts'
+
+it('explicit latest replaces a local profile package with its registry release', () => {
+  for (const source of ['file:/tmp/kiokuko-dsh-old.tgz', 'link:../../../checkout']) {
+    expect(latestRegistryUpdate(['update', 'kiokuko-dsh', '--latest'], { 'kiokuko-dsh': source })).toEqual(['add', 'kiokuko-dsh@latest'])
+  }
+})
+it('preserves registry updates, missing packages and non-latest or Git-pinned intent', () => {
+  for (const source of [undefined, '^0.2.44', 'git+https://example.invalid/pkg#fixed']) {
+    const args = ['update', 'kiokuko-dsh', '--latest']
+    expect(latestRegistryUpdate(args, source ? { 'kiokuko-dsh': source } : {})).toBe(args)
+  }
+  for (const args of [['update', 'kiokuko-dsh'], ['update', '--latest'], ['update', 'kiokuko-dsh', '--latest', '--recursive']]) {
+    expect(latestRegistryUpdate(args, { 'kiokuko-dsh': 'file:old.tgz' })).toBe(args)
+  }
+})
