+/** Explicit latest for one installed local package means its registry release.
+ * Keep registry, Git, missing packages and all other pnpm forms unchanged.
+ */
+export function latestRegistryUpdate(args: readonly string[], dependencies: Readonly<Record<string, string>>): readonly string[] {
+  if (!['update', 'up', 'upgrade'].includes(args[0] ?? '') || args.length !== 3 || !args.includes('--latest')) return args
+  const name = args[1] === '--latest' ? args[2] : args[1]
+  if (!name || !/^(?:@[a-z0-9._-]+\/)?[a-z0-9._-]+$/i.test(name) || !/^(?:file:|link:)/.test(dependencies[name] ?? '')) return args
+  return ['add', `${name}@latest`]
+}
+
