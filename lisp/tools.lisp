(in-package :kioku.tools)
(defstruct (tool-result (:constructor %make-tool-result)) name definition-id value)
(defun available-tools () (kioku.internal:rpc "tools-list" (kioku.internal:object)))
(defun call-tool (name &optional (arguments (kioku.internal:object)))
  "Compatibility call. The host resolves and pins the current admitted definition for this RPC."
  (kioku.internal:rpc "tool-call" (kioku.internal:object "name" name "args" arguments)))
(defun list () (available-tools))
(defun describe (name)
  (or (find name (available-tools) :test #'string= :key (lambda (item) (gethash "name" item)))
      (error "TOOL_UNAVAILABLE")))
(defun call (name &optional (arguments (kioku.internal:object)))
  "Return a Lisp structure around one exact admitted DSH tool response."
  (let* ((definition (describe name))
         (request (kioku.internal:object "name" name "args" arguments))
         (id (gethash "definitionId" definition)))
    (when id (setf (gethash "definitionId" request) id))
    (let ((value (kioku.internal:rpc "tool-call" request)))
      (%make-tool-result :name name :definition-id (gethash "definitionId" definition) :value value))))
(defun result-value (result) (unless (tool-result-p result) (error "TOOL_RESULT_REQUIRED")) (tool-result-value result))
