(in-package :kioku.internal)
(defvar *wire*)
(defvar *proposals* nil)
(defvar *inputs* #())
(defvar *objects* (make-hash-table :test 'equal))
(defvar *generation* (uiop:getenv "KIOKU_GENERATION"))
(defvar *counter* 0)
(defvar *request* nil)
(defvar *form-index* nil)
(defvar *task-scratch* nil)
(defun object (&rest pairs)
  (let ((h (make-hash-table :test 'equal)))
    (loop for (key value) on pairs by #'cddr do (setf (gethash key h) value)) h))
(defun emit (value)
  (let ((line (kioku.data:encode-json value)))
    (when (> (length (sb-ext:string-to-octets line :external-format :utf-8)) 1048575) (error "FRAME_TOO_LARGE"))
    (write-line line *wire*) (finish-output *wire*)))
(defun receive ()
  (let ((line (make-array 0 :element-type 'character :adjustable t :fill-pointer 0)))
    (loop for char = (read-char *wire* nil nil)
          do (unless char (return-from receive nil))
             (when (char= char #\Newline) (return))
             (when (>= (length line) 1048576) (error "FRAME_TOO_LARGE"))
             (vector-push-extend char line))
    (kioku.data:parse-json line)))
(defun rpc (method arguments)
  (let ((id (format nil "rpc-~D" (incf *counter*))))
    (emit (object "version" 1 "type" "rpc" "id" id "request" *request* "method" method "arguments" arguments))
    (let ((reply (receive)))
      (unless (and reply (equal id (gethash "id" reply))) (error "RPC_MISMATCH"))
      (unless (eq yason:true (gethash "ok" reply))
        (let ((code (gethash "code" reply "")))
          (when (and (stringp code) (alexandria:starts-with-subseq "CODE_" code))
            (error 'kioku.code:service-error :code code :message (gethash "error" reply)))
          (when (and (stringp code) (alexandria:starts-with-subseq "RECOVERY_" code))
            (error 'kioku.recovery:service-error :code code :message (gethash "error" reply)))
          (when (and (stringp code) (alexandria:starts-with-subseq "DECISION_" code))
            (error 'kioku.decisions:service-error :code code :message (gethash "error" reply)))
          (when (and (stringp code) (alexandria:starts-with-subseq "TYPESAFE_" code))
            (error 'kioku.typesafe:service-error :code code :message (gethash "error" reply))))
        (error "~A" (gethash "error" reply)))
      (gethash "value" reply))))
(defun printed (value)
  ;; print-length bounds elements, not arbitrary strings; the host independently caps frames/output.
  (let ((*print-length* 30) (*print-level* 6) (*print-circle* t) (*print-pretty* nil))
    (let ((text (prin1-to-string value))) (subseq text 0 (min 16000 (length text))))))
(defun evaluate-code (code)
  (let ((*package* (find-package :kioku.user)) (*read-eval* nil) (last nil))
    (with-input-from-string (in code)
      (loop for index from 0
            for form = (progn (setf *form-index* index) (read in nil in))
            until (eq form in) do (setf last (multiple-value-list (eval form))))
      (setf *form-index* nil))
    (object "printed" (printed last) "ref" (kioku.objects:retain (first last))
            "json" (handler-case
                        (let ((json (kioku.data:encode-json (first last))))
                          ;; Keep ordinary verifier logs in the saved result. Leave
                          ;; half the bounded frame for printed values/proposals.
                          (if (< (length (sb-ext:string-to-octets json :external-format :utf-8)) 524288) (kioku.data:parse-json json) nil))
                      (error () nil)))))
(defun compile-task (code)
  (let ((*read-eval* nil))
    (let ((form (with-input-from-string (stream code)
                  (let ((value (read stream nil stream)))
                    (when (or (eq value stream) (not (eq (read stream nil stream) stream)))
                      (error "TASK_SOURCE_INVALID"))
                    value))))
      (unless (and (consp form) (eq (first form) 'lambda)) (error "TASK_SOURCE_INVALID"))
      (compile nil form))))
(defun evaluate-task (code input-path)
  "Run one generated function with JSON data; leave the full result in scratch."
  (let ((*read-eval* nil))
      (let* ((function (compile-task code))
             (input (kioku.data:parse-json (uiop:read-file-string input-path)))
             (result (funcall function input))
             (json (kioku.data:encode-json result))
             (path (merge-pathnames "task-result.json" (kioku.files:scratch))))
        (when (> (length (sb-ext:string-to-octets json :external-format :utf-8)) 67108864)
          (error "TASK_RESULT_LIMIT"))
        (kioku.files:write-text path json)
        (object "path" "task-result.json" "bytes" (length (sb-ext:string-to-octets json :external-format :utf-8))))))
(defun task-request (request)
  ;; Fresh unqualified symbols and object refs; the same owner's process remains.
  ;; Arbitrary Common Lisp is not a heap security boundary.
  (let* ((*package* (make-package (symbol-name (gensym "KIOKU.TASK.")) :use '(:cl)))
         (*objects* (make-hash-table :test 'equal))
         (*task-scratch* (let ((scratch (gethash "scratch" request)))
                          (when scratch (uiop:ensure-directory-pathname scratch)))))
    (unwind-protect
        (if (equal "task-compile" (gethash "method" request))
            (progn (compile-task (gethash "code" request)) (object "compiled" yason:true))
            (evaluate-task (gethash "code" request) (gethash "input" request)))
      (delete-package *package*))))
(defun emit-failed-result (condition)
  (let* ((text (handler-case (princ-to-string condition) (error () "Lisp condition could not be printed.")))
         (message (subseq text 0 (min 4000 (length text))))
         (name (class-name (class-of condition)))
         (type (if (symbolp name) (symbol-name name) "ERROR"))
         (details (object "type" (subseq type 0 (min 256 (length type))) "message" message)))
    (when *form-index* (setf (gethash "formIndex" details) *form-index*))
    (emit (object "version" 1 "type" "result" "id" *request* "ok" yason:false
                  "value" message "condition" details "proposals" #()))))
(defun serve ()
  (setf *wire* (sb-sys:make-fd-stream 3 :input t :output t :element-type 'character :external-format :utf-8 :buffering :line))
  (emit (object "version" 1 "type" "ready"))
  (loop for request = (receive) while request do
    (let ((*request* (gethash "id" request)) (*form-index* nil) (*proposals* nil) (*inputs* (gethash "inputs" request #())))
      (handler-case
          (let ((value (cond ((equal "eval" (gethash "method" request)) (evaluate-code (gethash "code" request)))
                             ((member (gethash "method" request) '("task" "task-compile") :test #'equal) (task-request request))
                             ((equal "describe" (gethash "method" request)) (kioku.tools:describe-symbol (gethash "symbol" request "")))
                             ((equal "inspect" (gethash "method" request)) (kioku.objects:inspect-ref (gethash "ref" request)))
                             (t (error "UNKNOWN_METHOD")))))
            (finish-output *standard-output*) (finish-output *error-output*)
            (emit (object "version" 1 "type" "result" "id" *request* "ok" yason:true "value" value "proposals" (coerce (reverse *proposals*) 'vector))))
        (error (condition)
          (finish-output *standard-output*) (finish-output *error-output*)
          (emit-failed-result condition))))))
(in-package :kioku.data)
(defun parse-json (text)
  (let ((yason:*parse-json-arrays-as-vectors* t) (yason:*parse-json-booleans-as-symbols* t) (*read-eval* nil)) (yason:parse text)))
(defun encode-json (value) (with-output-to-string (s) (yason:encode value s)))
(defun read-csv (text) (cl-csv:read-csv text))
(defun write-csv (rows) (with-output-to-string (s) (cl-csv:write-csv rows :stream s)))
(defun read-tsv (text) (cl-csv:read-csv text :separator #\Tab))
(defun write-tsv (rows) (with-output-to-string (s) (cl-csv:write-csv rows :stream s :separator #\Tab)))
(defun map-jsonl (function stream &key (max-line-length 65536))
  "Call FUNCTION for each JSON value, reading at most MAX-LINE-LENGTH characters per line."
  (let ((line (make-array 0 :element-type 'character :adjustable t :fill-pointer 0)) (count 0))
    (labels ((flush-line () (when (plusp (length (string-trim '(#\Space #\Tab #\Return) line))) (funcall function (parse-json line)) (incf count)) (setf (fill-pointer line) 0)))
      (loop for char = (read-char stream nil nil) while char do
        (if (char= char #\Newline) (flush-line)
            (progn (when (>= (length line) max-line-length) (error "JSONL_LINE_LIMIT")) (vector-push-extend char line))))
      (flush-line)) count))
(defun parse-jsonl (text)
  (let ((items nil) (count 0))
    (with-input-from-string (stream text)
      (map-jsonl (lambda (value) (when (> (incf count) 10000) (error "JSONL_ITEM_LIMIT: use map-jsonl")) (push value items)) stream))
    (coerce (nreverse items) 'vector)))
(defun regex-matches (pattern text) (cl-ppcre:all-matches-as-strings pattern text))
(defun regex-replace (pattern text replacement) (cl-ppcre:regex-replace-all pattern text replacement))
(in-package :kioku.files)
(defun scratch () (or kioku.internal::*task-scratch* (pathname (uiop:getenv "KIOKU_SCRATCH"))))
(defun %scratch-path (name &key must-exist)
  "Resolve NAME below scratch without accepting absolute paths, traversal, or links."
  (let* ((root (truename (scratch)))
         (candidate (handler-case (merge-pathnames (pathname name) root)
                      (error () (error "INVALID_SCRATCH_PATH")))))
    (unless (and (uiop:relative-pathname-p (pathname name)) (uiop:subpathp candidate root))
      (error "INVALID_SCRATCH_PATH"))
    (let ((existing (probe-file candidate)))
      (when (and must-exist (null existing)) (error "SCRATCH_MISSING"))
      (when existing
        (let ((resolved (truename candidate)))
          (unless (equal (namestring resolved) (namestring candidate))
            (error "SCRATCH_LINK_REFUSED"))))
    candidate)))
(defun input (index)
  "Return the read-only snapshot path for a zero-based index in this evaluation's inputs."
  (aref kioku.internal:*inputs* index))
(defun read-text (path) (uiop:read-file-string path))
(defun write-text (path text) (with-open-file (s path :direction :output :if-exists :supersede :if-does-not-exist :create) (write-string text s)) path)
(defun %proposal-string (text min max)
  ;; Match the host's JavaScript string limits, including non-BMP characters.
  (check-type text string)
  (unless (<= min (loop for char across text sum (if (> (char-code char) #xffff) 2 1)) max)
    (error "PROPOSAL_STRING_LIMIT"))
  text)
(defun %proposal-path (path)
  ;; Pathnames are ordinary file arguments, but cannot cross the JSON wire.
  ;; Leave workspace ownership and protected-path checks to the host.
  (%proposal-string (etypecase path (string path) (pathname (namestring path))) 1 4096))
(defun propose-write (path content)
  "Propose a workspace-relative write; use WRITE-TEXT for scratch files."
  (when (>= (length kioku.internal:*proposals*) 100) (error "PROPOSAL_LIMIT"))
  (%proposal-string content 0 262144)
  (push (kioku.internal:object "operation" "write" "path" (%proposal-path path) "content" content) kioku.internal:*proposals*) path)
(defun propose-delete (path)
  "Propose a workspace-relative deletion; scratch files need no proposal."
  (when (>= (length kioku.internal:*proposals*) 100) (error "PROPOSAL_LIMIT"))
  (push (kioku.internal:object "operation" "delete" "path" (%proposal-path path)) kioku.internal:*proposals*) path)
(defun search-text (pattern paths &key (limit 1000))
  "Search explicitly selected input/scratch files; return bounded line excerpts."
  (let ((hits nil))
    (dolist (path paths)
      (with-open-file (stream path)
        (loop for line = (read-line stream nil nil) for number from 1 while line do
          (when (cl-ppcre:scan pattern line)
            (when (>= (length hits) (min limit 1000)) (return-from search-text (nreverse hits)))
            (push (kioku.internal:object "path" (namestring (pathname path)) "line" number "text" (subseq line 0 (min 400 (length line)))) hits)))))
    (nreverse hits)))
(defun diff-text (before after)
  "Produce a bounded whole-file text diff; no host files are changed."
  (when (> (+ (length before) (length after)) 262144) (error "DIFF_LIMIT"))
  (if (equal before after) ""
      (with-output-to-string (out)
        (format out "--- before~%+++ after~%")
        (dolist (pair (list (cons #\- before) (cons #\+ after)))
          (with-input-from-string (in (cdr pair))
            (loop for line = (read-line in nil nil) while line do (format out "~C~A~%" (car pair) line)))))))
(in-package :kioku.objects)
(defun retain (value)
  (when (>= (hash-table-count kioku.internal:*objects*) 1000) (error "REFERENCE_LIMIT: release references or reset"))
  (let ((id (format nil "~A/~D" kioku.internal:*generation* (incf kioku.internal::*counter*))))
    (setf (gethash id kioku.internal:*objects*) value) id))
(defun inspect-ref (id)
  (multiple-value-bind (value present) (gethash id kioku.internal:*objects*)
    (unless present (error "STALE_REFERENCE"))
    (kioku.internal:object "ref" id "type" (princ-to-string (type-of value)) "printed" (kioku.internal::printed value))))
(defun release (id) (remhash id kioku.internal:*objects*))
(defun register-artifact (scratch-relative-path)
  (kioku.internal:rpc "artifact" (kioku.internal:object "path" scratch-relative-path)))
(in-package :kioku.process)
(defun run (program arguments &key (timeout-ms 120000) (directory "."))
  "Run a protected program in a scratch-relative DIRECTORY. Inspect result-code; Lisp evaluation success is not process success."
  (kioku.internal:rpc "run" (kioku.internal:object "program" program "argv" (coerce arguments 'vector) "timeoutMs" timeout-ms "directory" directory)))
(defun python (code &key (timeout-ms 120000) (directory ".")) (run "python3" (list "-I" "-c" code) :timeout-ms timeout-ms :directory directory))
(defun shell (code &key (timeout-ms 120000) (directory ".")) (run "sh" (list "-c" code) :timeout-ms timeout-ms :directory directory))
(defvar *job-registry* nil)
(defun start-job (program arguments &key (timeout-ms 120000) (directory "."))
  "Start one managed job and retain its id for LIST-JOBS in this worker generation."
  (let ((id (kioku.internal:rpc "start-job" (kioku.internal:object "program" program "argv" (coerce arguments 'vector) "timeoutMs" timeout-ms "directory" directory))))
    (pushnew id *job-registry* :test #'equal)
    id))
(defun job-status (id) (kioku.internal:rpc "job-status" (kioku.internal:object "id" id)))
(defun cancel-job (id) (kioku.internal:rpc "cancel-job" (kioku.internal:object "id" id)))
(in-package :kioku.jobs)
(defun start (program arguments &key (timeout-ms 120000) (directory "."))
  (kioku.process:start-job program arguments :timeout-ms timeout-ms :directory directory))
(defun status (id) (kioku.process:job-status id))
(defun cancel (id) (kioku.process:cancel-job id))
(defun await (id &key (timeout-ms 120000) (poll-ms 50))
  "Wait for one managed job while preserving its host receipt and without relaunching it."
  (let ((deadline (+ (get-internal-real-time) (round (* timeout-ms internal-time-units-per-second) 1000))))
    (loop for result = (status id)
          for state = (and (hash-table-p result) (gethash "state" result))
          unless (or (equal state "RUNNING") (and (hash-table-p result) (equal (gethash "state" (gethash "receipt" result (make-hash-table))) "started"))) return result
          do (when (>= (get-internal-real-time) deadline) (error "JOB_AWAIT_TIMEOUT: job remains managed; inspect or cancel it."))
             (sleep (/ poll-ms 1000.0)))))
(in-package :kioku.test)
(defstruct (test-spec (:constructor %make-test-spec)) framework files directory timeout-ms name-pattern isolation config-loader)
(defstruct (test-result (:constructor %make-test-result)) spec status summary failures raw)
(defun spec (&key framework files (directory ".") (timeout-ms 120000) name-pattern isolation config-loader)
  "Create a typed test operation. It has no command-string identity."
  (unless (member framework '(:node-test :vitest)) (error "TEST_FRAMEWORK_INVALID: use :NODE-TEST or :VITEST."))
  (%make-test-spec :framework framework :files (test-files files) :directory directory :timeout-ms timeout-ms
                   :name-pattern name-pattern :isolation isolation :config-loader config-loader))
(defun spec-operation (value)
  (let ((operation (kioku.internal:object
                     "kind" "test" "adapter" (ecase (test-spec-framework value) (:node-test "node-test") (:vitest "vitest"))
                     "adapterVersion" 1 "files" (coerce (test-spec-files value) 'vector)
                     "directory" (test-spec-directory value) "timeoutMs" (test-spec-timeout-ms value)
                     "isolation" (if (eq (test-spec-isolation value) :none) "none" "default"))))
    (when (test-spec-name-pattern value) (setf (gethash "namePattern" operation) (test-spec-name-pattern value)))
    (when (test-spec-config-loader value) (setf (gethash "configLoader" operation) (string-downcase (string (test-spec-config-loader value)))))
    operation))
(defun run (value)
  "Execute a TEST-SPEC and return a structured TEST-RESULT."
  (unless (test-spec-p value) (error "TEST_SPEC_REQUIRED: call KIOKU.TEST:SPEC first."))
  (let* ((operation (spec-operation value))
         (framework (test-spec-framework value))
         (program (if (eq framework :node-test) "node" "./node_modules/.bin/vitest"))
         (arguments (if (eq framework :node-test)
                        (append '("--test" "--test-reporter=tap")
                                (when (eq (test-spec-isolation value) :none) '("--experimental-test-isolation=none"))
                                (when (test-spec-name-pattern value) (list (concatenate 'string "--test-name-pattern=" (test-spec-name-pattern value))))
                                (test-spec-files value))
                        (append '("run" "--reporter=json" "--includeTaskLocation")
                                (when (test-spec-config-loader value) (list "--configLoader" (string-downcase (string (test-spec-config-loader value)))))
                                (when (test-spec-name-pattern value) (list (concatenate 'string "--testNamePattern=" (test-spec-name-pattern value))))
                                (test-spec-files value))))
         (raw (kioku.internal:rpc "run" (kioku.internal:object "program" program "testRunner" (if (eq framework :node-test) "node" "vitest")
               "operation" operation "directory" (test-spec-directory value) "timeoutMs" (test-spec-timeout-ms value) "argv" (coerce arguments 'vector)))))
    (%make-test-result :spec value :status (gethash "testStatus" raw) :summary (gethash "summary" raw)
                       :failures (gethash "failures" raw) :raw raw)))
(defun passed-p (result) (and (test-result-p result) (equal (test-result-status result) "passed")))
(defun failures (result) (unless (test-result-p result) (error "TEST_RESULT_REQUIRED")) (test-result-failures result))
(defun result-summary (result) (unless (test-result-p result) (error "TEST_RESULT_REQUIRED")) (test-result-summary result))
(defun result-raw (result) (unless (test-result-p result) (error "TEST_RESULT_REQUIRED")) (test-result-raw result))
(in-package :kioku.verify)
(defstruct (verification-definition (:constructor %make-verification-definition)) criterion-id operation source-paths receipt)
(defun bind (&key criterion-id operation source-paths)
  "Bind a typed operation to an existing completion criterion without re-entering a command."
  (unless (and (stringp criterion-id) (kioku.test::test-spec-p operation) (listp source-paths) source-paths)
    (error "VERIFICATION_DEFINITION_INVALID"))
  (let* ((method (kioku.internal:object "kind" "typed_operation" "definitionVersion" 1
                   "operation" (kioku.test::spec-operation operation) "sourcePaths" (coerce source-paths 'vector)
                   "assertion" "selected_tests_pass"))
         (receipt (kioku.tools:call-tool "task_completion"
                    (kioku.internal:object "action" "bind" "criterionId" criterion-id "method" method))))
    (%make-verification-definition :criterion-id criterion-id :operation operation :source-paths source-paths :receipt receipt)))
(defun run (definition)
  "Run exactly the typed operation retained by BIND. The host associates only its own execution receipt."
  (unless (verification-definition-p definition) (error "VERIFICATION_DEFINITION_REQUIRED"))
  (kioku.test:run (verification-definition-operation definition)))
(defun status () (kioku.tools:call-tool "task_completion" (kioku.internal:object "action" "status")))
(defun definition-receipt (definition)
  (unless (verification-definition-p definition) (error "VERIFICATION_DEFINITION_REQUIRED"))
  (verification-definition-receipt definition))
(in-package :kioku.session)
(defun save (name value &key (kind :json))
  "Explicitly save JSON data or a result reference. Streams, processes and live handles are rejected by JSON encoding."
  (unless (member kind '(:json :result-ref)) (error "SESSION_KIND_INVALID"))
  (kioku.internal:rpc "session-save" (kioku.internal:object "name" name
    "kind" (if (eq kind :json) "json" "result_ref") "value" value)))
(defun restore (name)
  "Read a saved value without treating old execution evidence as currently valid."
  (let ((saved (kioku.internal:rpc "session-restore" (kioku.internal:object "name" name))))
    (and saved (gethash "value" saved))))
(defun list-saved () (kioku.internal:rpc "session-list" (kioku.internal:object)))
(in-package :kioku.functions)
(defun definition-form (name source)
  (unless (and (stringp name) (stringp source)) (error "DEFINITION_INVALID"))
  (let ((*read-eval* nil))
    (multiple-value-bind (form end) (read-from-string source nil nil)
      (unless (and form (= end (length source)) (listp form) (member (first form) '(defun defmacro))
                   (symbolp (second form)) (string-equal name (symbol-name (second form))))
        (error "DEFINITION_INVALID: save exactly one matching DEFUN or DEFMACRO form."))
      form)))
(defun save-definition (name source)
  "Save one inert DEFUN/DEFMACRO source reference. It is not evaluated automatically after restart."
  (let ((form (definition-form name source)))
    (kioku.internal:rpc "session-save" (kioku.internal:object "name" name "kind" "definition"
      "value" (kioku.internal:object "source" source "form" (string-downcase (symbol-name (first form))))))))
(defun restore-definition (name)
  "Explicitly restore and evaluate one previously validated definition; returns the host revision."
  (let ((saved (kioku.internal:rpc "session-restore" (kioku.internal:object "name" name))))
    (unless (and saved (equal (gethash "kind" saved) "definition")) (error "DEFINITION_MISSING"))
    (let* ((value (gethash "value" saved)) (source (gethash "source" value)) (form (definition-form name source)))
      (eval form)
      (gethash "revision" saved))))
(in-package :kioku.test)
(defun test-files (files)
  (let ((paths (if (stringp files) (list files) files)))
    (unless (and (listp paths) paths
                 (let ((count (list-length paths))) (and count (<= count 100)))
                 (every (lambda (path)
                          (and (stringp path) (<= 1 (length path) 4096)
                               (char/= (char path 0) #\-)
                               (not (find (code-char 0) path))))
                        paths))
      (error "TEST_FILES_INVALID: supply one path or a list of up to 100 paths."))
    paths))
(defun run-tests (runner program arguments files name-pattern directory timeout-ms)
  (unless (or (null name-pattern) (and (stringp name-pattern) (<= 1 (length name-pattern) 4096)
                                      (not (find (code-char 0) name-pattern))))
    (error "TEST_PATTERN_INVALID: supply a nonempty regular expression string."))
  (kioku.internal:rpc "run"
    (kioku.internal:object "program" program "testRunner" runner "directory" directory "timeoutMs" timeout-ms
      "argv" (coerce (append arguments
        (when name-pattern
          (list (concatenate 'string (if (equal runner "node") "--test-name-pattern=" "--testNamePattern=") name-pattern)))
        (test-files files)) 'vector))))
(defun node (files &key (directory ".") (timeout-ms 120000) tsx name-pattern isolation)
  "Run selected Node tests with TAP. FILES is a path or list. TSX loads the project's tsx. ISOLATION :NONE supports protected scratch. Inspect testStatus, summary, failures and code."
  (run-tests "node" "node"
    (append (when tsx '("--import" "tsx")) '("--test" "--test-reporter=tap")
            (ecase isolation ((nil) nil) (:none '("--experimental-test-isolation=none"))))
    files name-pattern directory timeout-ms))
(defun vitest (files &key (directory ".") (timeout-ms 120000) config-loader name-pattern)
  "Run selected tests with the project's installed Vitest and its JSON reporter. CONFIG-LOADER accepts :NATIVE, :RUNNER or :BUNDLE. Inspect testStatus, summary, failures and code."
  (run-tests "vitest" "./node_modules/.bin/vitest"
    (append '("run" "--reporter=json" "--includeTaskLocation")
            (when config-loader (list "--configLoader" (ecase config-loader (:native "native") (:runner "runner") (:bundle "bundle")))))
    files name-pattern directory timeout-ms))
(in-package :kioku.ci)
(defun list-runs (&key (limit 10))
  "List recent GitHub Actions runs for the bound workspace repository."
  (kioku.internal:rpc "ci-list-runs" (kioku.internal:object "limit" limit)))
(defun failed-log (run-id)
  "Read failed logs for one numeric run id in the bound workspace repository."
  (kioku.internal:rpc "ci-failed-log" (kioku.internal:object "runId" (princ-to-string run-id))))
(defun verify (target &key script (directory ".") (location :workspace))
  "Run an approved npm verifier in a relative DIRECTORY under :workspace or :scratch. :test accepts :script naming test or test:*."
  (let ((request (kioku.internal:object "target" (string-downcase (string target)))))
    (when script (setf (gethash "script" request) script))
    (unless (equal directory ".") (setf (gethash "directory" request) directory))
    (unless (eq location :workspace) (setf (gethash "location" request) (string-downcase (string location))))
    (kioku.internal:rpc "ci-verify" request)))
(in-package :kioku.packages)
(defun metadata (name &key (version "latest"))
  "Approved public npm metadata lookup for NAME and an exact VERSION or latest; no arbitrary URLs."
  (kioku.internal:rpc "packages" (kioku.internal:object "kind" "metadata" "name" name "version" version)))
(defun audit (versions)
  "Approved public npm bulk advisory lookup. VERSIONS is a hash table of at most ten names/exact versions."
  (kioku.internal:rpc "packages" (kioku.internal:object "kind" "audit" "versions" versions)))
(defun update-lockfiles (versions &key (directory "."))
  "Generate root npm/pnpm locks in protected network scratch, then propose the frozen manifest/lockfile batch. Persistent eval only."
  (let ((result (kioku.internal:rpc "packages" (kioku.internal:object "kind" "update" "versions" versions "directory" directory))))
    (when (and (equal (gethash "state" result) "SUCCEEDED") (eq (gethash "generatedOnly" result) yason:true))
      (loop for file across (gethash "files" result) do
        (kioku.files:propose-write (gethash "path" file) (gethash "content" file)))
      (setf (gethash "proposedFiles" result) (map 'vector (lambda (file) (gethash "path" file)) (gethash "files" result)))
      (remhash "files" result))
    result))
(in-package :kioku.typesafe)
(define-condition service-error (error)
  ((code :initarg :code :reader error-code) (message :initarg :message :reader service-message))
  (:report (lambda (condition stream) (format stream "~A: ~A" (error-code condition) (service-message condition)))))
(defun status ()
  "Return configured/source/writable metadata without a key or network request."
  (kioku.internal:rpc "typesafe-status" (kioku.internal:object)))
(defun evaluate (state questions &key (model "jev-latest") (timeout-ms 30000))
  "Explicitly send selected JSON material to TypeSafe. QUESTIONS is a hash table of noul/choice/score questions. Return answers/model/usage; service-error is catchable. No retries or proposal approval."
  (let* ((request (kioku.internal:object "state" state "questions" questions "model" model "timeoutMs" timeout-ms))
         (bytes (handler-case (length (sb-ext:string-to-octets (kioku.data:encode-json request) :external-format :utf-8))
                  (error () (error 'service-error :code "TYPESAFE_INVALID_REQUEST" :message "TypeSafe requires JSON values.")))))
    (when (> bytes 262144)
      (error 'service-error :code "TYPESAFE_REQUEST_TOO_LARGE" :message "TypeSafe request exceeds 256 KiB; select less material."))
    (kioku.internal:rpc "typesafe-evaluate" request)))
(in-package :kioku.decisions)
(define-condition service-error (error)
  ((code :initarg :code :reader error-code) (message :initarg :message :reader service-message))
  (:report (lambda (condition stream) (format stream "~A: ~A" (error-code condition) (service-message condition)))))
(defun status () (kioku.internal:rpc "decisions-status" (kioku.internal:object)))
(defun evaluate (evidence questions)
  "QUESTIONS is an ordered vector of id/instructions/choices/abstainId objects. Read status then result.answers. No effects or approval."
  (kioku.internal:rpc "decisions-evaluate" (kioku.internal:object "purpose" "lisp" "state" evidence "questions" questions)))
(defun question (id instructions choices)
  (kioku.internal:object "id" id "instructions" instructions "choices" choices "abstainId" "abstain"))
(defun choice (id description) (kioku.internal:object "id" id "description" description))
(defun assess-relevance (requirement candidates)
  "CANDIDATES is an ordered vector of id/description objects; answers retain candidate IDs."
  (evaluate requirement (map 'vector (lambda (candidate)
    (question (gethash "id" candidate) (format nil "Assess relevance: ~A" (gethash "description" candidate))
      (vector (choice "yes" "Applicable") (choice "no" "Not applicable") (choice "abstain" "Insufficient evidence")))) candidates)))
(defun classify-failure (evidence actions)
  "ACTIONS is an ordered vector of id/description objects; no action is executed. Reserve abstain."
  (evaluate evidence (vector (question "failure-action" "Choose the supported next diagnostic action."
    (concatenate 'vector actions (vector (choice "abstain" "Insufficient evidence")))))))
(defun assess-change (requirement before after)
  (evaluate (kioku.internal:object "requirement" requirement "before" before "after" after)
    (vector (question "change" "Does the change satisfy the requirement without an evident regression?"
      (vector (choice "yes" "Satisfies requirement") (choice "no" "Missing requirement or regression") (choice "abstain" "Insufficient evidence"))))))
(in-package :kioku.recovery)
(define-condition service-error (error)
  ((code :initarg :code :reader error-code) (message :initarg :message :reader service-message))
  (:report (lambda (condition stream) (format stream "~A: ~A" (error-code condition) (service-message condition)))))
(defun select-restart (condition context choices &key (timeout-ms 10000))
  "Inside HANDLER-BIND, select one live zero-argument restart. CONTEXT is explicit JSON evidence;
CHOICES contains 1-8 (restart-name description) pairs. No expression replay or automatic retry."
  (unless (and (typep condition 'condition) (listp choices) (<= 1 (length choices) 8)
               (integerp timeout-ms) (<= 100 timeout-ms 30000))
    (error "RECOVERY_INVALID_INPUT"))
  (let* ((ticket (format nil "~A/~A/~D" kioku.internal:*generation* kioku.internal::*request* (incf kioku.internal::*counter*)))
         (restarts (mapcar (lambda (choice)
                     (unless (and (listp choice) (= (length choice) 2) (symbolp (first choice))
                                  (stringp (second choice)) (<= 1 (length (second choice)) 1024))
                       (error "RECOVERY_INVALID_INPUT"))
                     (or (find-restart (first choice) condition) (error "RECOVERY_RESTART_MISSING"))) choices))
         (ids (loop for i below (length choices) collect (format nil "~A/~D" ticket i))))
    (unless (= (length restarts) (length (remove-duplicates restarts))) (error "RECOVERY_DUPLICATE_RESTART"))
    (let* ((reply (kioku.internal:rpc "recovery-select"
                    (kioku.internal:object "ticket" ticket "condition" (symbol-name (type-of condition))
                      "context" context "timeoutMs" timeout-ms
                      "restarts" (coerce (loop for choice in choices for id in ids
                                          collect (kioku.internal:object "id" id "description" (second choice))) 'vector))))
           (selected (and (equal ticket (gethash "ticket" reply))
                          (position (gethash "restartId" reply) ids :test #'equal))))
      (unless selected (error "RECOVERY_STALE"))
      (let ((restart (nth selected restarts)))
        (unless (member restart (compute-restarts condition)) (error "RECOVERY_STALE"))
        (invoke-restart restart)))))
(defun restart-argument-valid-p (type value)
  (cond ((string= type "string") (stringp value))
        ((string= type "integer") (integerp value))
        ((string= type "boolean") (or (eq value yason:true) (eq value yason:false)))
        ((string= type "json") t)
        (t nil)))
(defun await-restart (condition context choices)
  "Suspend this live stack and let the main model select a Restart. Each choice is (symbol description argument-types)."
  (unless (and (typep condition 'condition) (listp choices) (<= 1 (length choices) 8)) (error "RECOVERY_INVALID_INPUT"))
  (let* ((ticket (format nil "~A/~A/~D" kioku.internal:*generation* kioku.internal::*request* (incf kioku.internal::*counter*)))
         (records (loop for choice in choices for index from 0 collect
                    (destructuring-bind (name description &optional (argument-types #())) choice
                      (unless (and (symbolp name) (stringp description) (vectorp argument-types)
                                   (every (lambda (item) (member item '("string" "integer" "boolean" "json") :test #'string=)) argument-types))
                        (error "RECOVERY_INVALID_INPUT"))
                      (let ((restart (or (find-restart name condition) (error "RECOVERY_RESTART_MISSING"))))
                        (list restart argument-types (kioku.internal:object "id" (format nil "~A/~D" ticket index)
                          "name" (symbol-name name) "description" description "arguments" argument-types))))))
         (reply (kioku.internal:rpc "restart-await" (kioku.internal:object "ticket" ticket
                  "condition" (kioku.internal:object "type" (symbol-name (type-of condition))
                    "message" (let ((message (princ-to-string condition))) (subseq message 0 (min 8000 (length message)))) "context" context)
                  "restarts" (coerce (mapcar #'third records) 'vector))))
         (restart-id (and (equal ticket (gethash "ticket" reply)) (gethash "restartId" reply)))
         (record (find restart-id records :test #'equal :key (lambda (item) (gethash "id" (third item)))))
         (arguments (and record (gethash "args" reply))))
    (unless (and record (vectorp arguments) (= (length arguments) (length (second record)))
                 (every #'restart-argument-valid-p (second record) arguments)
                 (member (first record) (compute-restarts condition)))
      (error "RECOVERY_STALE"))
    (apply #'invoke-restart (first record) (coerce arguments 'list))))
